# 自动检测文本/二进制文件
* text=auto

# Shell 脚本强制 LF（Docker 容器内执行需要）
*.sh text eol=lf
docker-entrypoint.sh text eol=lf

# Windows 批处理脚本保持 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
