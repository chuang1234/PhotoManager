# ═════════════════════════════════════════════
# PhotoManager Docker 部署环境配置
# 使用方法：复制此文件为 .env 并修改配置
#   cp .env.docker .env
# ═════════════════════════════════════════════

# ── MySQL 数据库配置 ──
DB_PASSWORD=Chuang@123456

# ── JWT 密钥（建议替换为随机字符串）──
# 生成方式：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=f7a3b9c2d1e8f6a4b0c5d3e2f1a9b8c7d6e5f4a3b2c1d0e9f8a7b6c5d4e3f2
JWT_EXPIRE_HOURS=24

# ── AI 服务配置（可选，不配置也不影响相册核心功能）──
# 提供商：openai | ollama
AI_PROVIDER=ollama
AI_MODEL=qwen2.5:14b
# ⚠️ Docker 环境注意：localhost 指向容器自身，需用 host.docker.internal 访问宿主机
# 如果 Ollama 运行在宿主机上，取消下面这行注释：
# AI_API_BASE=http://host.docker.internal:11434
# 如果使用 OpenAI / DeepSeek / 通义千问：
# AI_API_KEY=sk-xxx
# AI_API_BASE=https://api.openai.com/v1
AI_TIMEOUT=60

# ── 端口配置 ──
FRONTEND_PORT=80
BACKEND_PORT=5000
# Docker 内部 MySQL 映射到宿主机的端口
# 如果本机已装 MySQL，改为 3307 等避免端口冲突
# 注意：改这里只影响从宿主机用客户端连接 Docker MySQL
# 后端容器内部始终通过 Docker 网络访问 MySQL，不受此端口影响
MYSQL_PORT=3307
