# ── AI 服务配置 ──────────────────────────────
# 提供商：openai（默认）| ollama（本地部署，无需 API Key）
AI_PROVIDER=openai

# OpenAI / DeepSeek / 通义千问
AI_API_KEY=sk-xxx
AI_API_BASE=https://api.openai.com/v1
AI_MODEL=gpt-3.5-turbo

# ── 使用 Ollama 本地部署时，改为以下配置 ───────
# AI_PROVIDER=ollama
# AI_MODEL=llama3
# AI_API_BASE=http://localhost:11434

# ── 通用 ─────────────────────────────────────
AI_TIMEOUT=60