# ── 数据库配置 ──────────────────────────────
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=Chuang@123456
DB_NAME=family_photo

# ── JWT 密钥（建议替换为自己的随机字符串！）──────
# 生成方式：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=f7a3b9c2d1e8f6a4b0c5d3e2f1a9b8c7d6e5f4a3b2c1d0e9f8a7b6c5d4e3f2
JWT_EXPIRE_HOURS=24

# ── AI 服务配置 ──────────────────────────────
# 提供商：openai（默认）| ollama（本地部署，无需 API Key）
AI_PROVIDER=ollama

# 模型名称（Ollama 示例：llama3 / qwen2.5:14b / gemma2）
AI_MODEL=qwen2.5:14b

# Ollama 服务地址（默认 http://localhost:11434）
# AI_API_BASE=http://localhost:11434

# 请求超时秒数（默认 60）
# AI_TIMEOUT=60

# ── 如果使用 OpenAI / DeepSeek / 通义千问 ───────
# AI_PROVIDER=openai
# AI_API_KEY=sk-xxx
# AI_API_BASE=https://api.openai.com/v1
# AI_MODEL=gpt-3.5-turbo